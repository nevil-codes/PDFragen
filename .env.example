# Copy to .env and fill in. Never commit .env.

# --- LLM (generation) ---
# OpenAI API key, used only for answer generation (not embeddings).
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- Embeddings (local, no API key needed) ---
# Multilingual sentence-transformers model. Good German coverage.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Chunking ---
# Tuned for German prose (longer compound words, longer sentences).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K=4

# --- Storage ---
CHROMA_DIR=chroma_db
COLLECTION_NAME=pdfragen
