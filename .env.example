# Copy to .env and fill in (defaults below work for a local Ollama install).
# Never commit .env.

# --- LLM (generation, local via Ollama) ---
# Requires `ollama serve` running and the model pulled: `ollama pull llama3.1:8b`
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b

# --- Embeddings (local, no API key needed) ---
# Multilingual sentence-transformers model. Good German coverage.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# --- Chunking ---
# Tuned for German prose (longer compound words, longer sentences).
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K=4

# --- Storage ---
CHROMA_DIR=chroma_db
COLLECTION_NAME=pdfragen
